# I domini arrivano dalle variabili d'ambiente (vedi .env / docker-compose.yml).
# Caddy ottiene e rinnova automaticamente i certificati Let's Encrypt.
# Senza dominio proprio si può usare sslip.io, es. APP_DOMAIN=app.1.2.3.4.sslip.io

{$APP_DOMAIN} {
	reverse_proxy frontend:80
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	reverse_proxy backend:8080
}

# Dominio legacy: l'app resta raggiungibile ma viene portata sul dominio canonico.
{$LEGACY_APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$LEGACY_API_DOMAIN} {
	reverse_proxy backend:8080
}

# Copiare in .env sul server e compilare. NON committare il .env.

# --- Domini (senza https://). Dominio canonico: splitbill.it / api.splitbill.it
# Senza dominio proprio usare sslip.io:
# APP_DOMAIN=app.<IP-VPS>.sslip.io   API_DOMAIN=api.<IP-VPS>.sslip.io
APP_DOMAIN=splitbill.it
API_DOMAIN=api.splitbill.it
# Origini CORS backend separate da virgola (default compose: https://${APP_DOMAIN})
# CORS_ALLOWED_ORIGINS=https://splitbill.it,https://app.92.222.87.111.sslip.io
# Domini legacy gestiti da Caddy: redirect app / proxy API
# LEGACY_APP_DOMAIN=app.92.222.87.111.sslip.io
# LEGACY_API_DOMAIN=api.92.222.87.111.sslip.io

# --- Database PostgreSQL
POSTGRES_DB=splitbill
POSTGRES_USER=splitbill
POSTGRES_PASSWORD=changeme

# --- JWT: generare con `openssl rand -base64 64`
JWT_SECRET=
JWT_VALIDITY=86400

# --- SMTP (per conferma registrazione / reset password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Login con Google
# OAuth Client ID di tipo "Web application" da Google Cloud Console
# (API e servizi > Credenziali). Lo stesso valore è usato dal backend
# (verifica degli ID token) e passato al frontend come build arg
# (VITE_GOOGLE_CLIENT_ID). Se vuoto, il login con Google è disabilitato.
GOOGLE_CLIENT_ID=

# --- JVM (opzionale, default -Xmx768m)
# JAVA_TOOL_OPTIONS=-Xmx768m
